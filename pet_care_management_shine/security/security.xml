<odoo>
    <data noupdate="0">

        <!-- Define a Custom Security Group -->
        <record id="group_pet_user" model="res.groups">
            <field name="name">Pet Owner Access</field>
           
        </record>
        
        
        <record id="group_pet_care_admin" model="res.groups">
            <field name="name">Pet Care Admin</field>
           
        </record>
        
       
        

        <!-- Record Rule: Users Can Only View Their Own Pet Records -->
        <record id="pet_pet_owner_rule" model="ir.rule">
            <field name="name">Pet: Users Can Only View Their Own Records</field>
            <field name="model_id" ref="pet_care_management_shine.model_pet_pet"/>
            <field name="domain_force">[('owner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('pet_care_management_shine.group_pet_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        
        
          <record id="pet__owner_sale_rule" model="ir.rule">
            <field name="name">Pet: Users Can Only View sale</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('pet_care_management_shine.group_pet_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        
        
        
        
        
        
       
       
        

    </data>
</odoo>