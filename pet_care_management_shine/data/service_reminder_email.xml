<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <data >



	 <record id="service_reminder" model="mail.template">
			            <field name="name">Monthly Service Reminder Email</field>
			            <field name="model_id" ref="pet_care_management_shine.model_res_partner"/>
			            <field name="subject">{{object.name}} monthly Reminder</field>
						           
			           <field name="email_from">{{user.email}}</field>
			           <field name="email_to">{{object.email}}</field>
			           <field name="description">Add Description</field>
			           <field name="body_html" type="html">
			               <div style="margin: 0px; padding: 0px;">
			                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
			                        Dear Member,
			                        <br/><br/>
			                        This is a notification 
			                        that its time for Your Monthly Pet service.
			                        <br/><br/>
			                        Best regards,<br/>
			                        test company
                  			  </p>
               			 </div>
			           </field>
			   </record>
   </data>
</odoo>      


 