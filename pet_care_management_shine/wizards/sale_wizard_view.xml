<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.wizard.view.form</field>
        <field name="model">sale.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Message">
                <group>
                    
                    <field name="order_date" />
                   
                   <!--  <field name="sale_line" />-->
                     
                </group>
                
                <notebook> 
                
                <page string="Bulk Sale">
                
                
										<field name="bulk_order_line_ids" nolable="0">
											<list editable="bottom" >
												<field name="partner_id" />
												<field name="pet_id" />
												<field name="product_template_id" />
												<field name="quantity" />
												
												<field name="delivered" />
												<field name="invoiced" />
												<field name="unit_price" />
												<field name="tax_ids" widget="many2many_tags"/>
												<field name="disc" />
												<field name="amount" />
												
											</list>
										</field>
                
                
               </page>
                
                
                </notebook>
              
                
               
                
                <footer>
                   <button name="action_create_sale_orders" type="object" string="Sell bulk" class="oe_highlight" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bulk_sale" model="ir.actions.act_window">
        <field name="name">Sale</field>
        <field name="res_model">sale.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale_wizard_view_form" />
        <field name="target">new</field>
    </record>

</odoo>